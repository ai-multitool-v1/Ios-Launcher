<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Container engine: guest apps run inside the host process, so every
         permission a guest needs at runtime must be granted to the host. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Clone import: enumerate installed applications. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- In-app updater: download and install APKs hosted on GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ClonerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SetbdCloner.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Routed intent used by clone home-screen shortcuts. -->
            <intent-filter>
                <action android:name="org.setbd.cloner.ACTION_LAUNCH_CLONE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Container stub activities.

            Guest activities are not installed with the system; the engine maps
            every guest activity onto one of these declared components and then
            swaps the real guest class in through the instrumentation hook.
            configChanges prevents Android from recreating the (foreign) guest
            activity on configuration changes, which the engine does not support.
        -->
        <activity
            android:name=".engine.stub.StubActivity"
            android:exported="false"
            android:excludeFromRecents="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Cloner.Stub"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale|fontWeightAdjustment" />

        <activity
            android:name=".engine.stub.StubTransparentActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Cloner.StubTransparent"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale|fontWeightAdjustment" />

        <activity
            android:name=".engine.stub.StubSingleTaskActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Cloner.Stub"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale|fontWeightAdjustment" />

        <activity
            android:name=".engine.stub.StubSingleInstanceActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Cloner.Stub"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale|fontWeightAdjustment" />
    </application>

</manifest>
