<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Post-splash theme used by the host application. -->
    <style name="Theme.SetbdCloner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- System splash (Android 12+ real splash / pre-12 compat window). -->
    <style name="Theme.SetbdCloner.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SetbdCloner</item>
    </style>

    <!-- Opaque host surface backing guest activities. -->
    <style name="Theme.Cloner.Stub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Translucent surface for guest dialog-style activities. -->
    <style name="Theme.Cloner.StubTransparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

</resources>
